SUPABASE_URL=https://vmpkiwfvnlzraabtjkig.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional but recommended: enables duplicate-signup detection and lets an
# unsubscribe cancel the emails still queued in Resend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required to send the Oikos Journey. Without it a signup is still stored,
# it simply does not trigger any email.
RESEND_API_KEY=re_your_resend_api_key
# Optional overrides — these already default to the team.thykingdom.net sender.
# RESEND_FROM=Daniel at Oikos Map <oikos@team.thykingdom.net>
# RESEND_REPLY_TO=hello@thykingdom.net

GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-workflow-webhook
